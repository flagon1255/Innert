#version 460

// Runs after traverse.comp in shaded mode: removes noise, adds bloom, then tone maps
// and color grades into the image that gets shown.

// Has to match the PostStage enum in main.rs
const uint DENOISE = 0;
const uint BLOOM_EXTRACT = 1;
const uint BLOOM_BLUR_X = 2;
const uint BLOOM_BLUR_Y = 3;
const uint TONEMAP = 4;

// Has to match the POST_* constants in main.rs
const uint POST_ENCODE_SRGB = 1;
const uint POST_GRADE = 2;
const uint POST_DENOISE = 4;

// Has to match BLOOM_SCALE in main.rs: bloom is computed at 1/4 of the render resolution
const int BLOOM_SCALE = 4;

const float EXPOSURE = 0.78;
// Colors are made richer before tone mapping, which washes out bright ones, and again after
const float RICHNESS = 1.1;
const float SATURATION = 1.2;
// Above 1 deepens the mid tones and shadows
const float CONTRAST = 1.15;
const float BLOOM_THRESHOLD = 0.8;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint stage;
    uint step; // Spacing between the denoiser's samples, it doubles every pass
    uint flags;
    float bloom; // Strength
} pc;

// Linear light, the color divided by guideImage's, with alpha being how many frames were averaged
// into it
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D hdrIn;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D hdrOut;
// Written by traverse.comp, see there
layout(set = 0, binding = 2, r32f) readonly uniform image2D depthImage;
layout(set = 0, binding = 3, rgba32f) readonly uniform image2D guideImage;
layout(set = 0, binding = 4, rgba32f) readonly uniform image2D bloomIn;
layout(set = 0, binding = 5, rgba32f) writeonly uniform image2D bloomOut;
layout(set = 0, binding = 6, rgba8) writeonly uniform image2D targetImage;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/
vec3 aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0, 1);
}

vec3 linearToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1 / 2.4)) - 0.055, step(0.0031308, c));
}

// The color of a pixel of hdrIn's light
vec3 colorAt(ivec2 p, vec3 light) {
    return light * imageLoad(guideImage, p).rgb;
}

// One pass of an edge-avoiding à-trous filter (Dammertz et al. 2010). It blurs the lighting
// only, not the voxel colors, and never across edges where the depth or the face direction
// changes. Pixels that have averaged enough frames already are left alone.
void denoise(ivec2 p) {
    vec4 center = imageLoad(hdrIn, p);
    float depth0 = imageLoad(depthImage, p).r;
    vec4 guide0 = imageLoad(guideImage, p);
    float settled = (pc.flags & POST_DENOISE) != 0 ? smoothstep(4, 24, center.a) : 1;
    // Sky (no depth), water and grass (7) have no noise to speak of, and what's held (8 and up)
    // gets steady light
    if (depth0 < 0 || guide0.w > 6.5 || settled >= 1) {
        imageStore(hdrOut, p, center);
        return;
    }

    const float KERNEL[3] = float[3](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
    ivec2 size = imageSize(hdrIn);
    float light0 = luminance(center.rgb);

    vec3 sum = vec3(0);
    float weights = 0;
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            ivec2 q = p + ivec2(x, y) * int(pc.step);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size)))
            continue;
            vec4 guide = imageLoad(guideImage, q);
            float depth = imageLoad(depthImage, q).r;
            if (guide.w != guide0.w || depth < 0)
            continue;
            vec3 light = imageLoad(hdrIn, q).rgb;
            float w = KERNEL[abs(x)] * KERNEL[abs(y)]
                * exp(-abs(depth - depth0) / (0.02 * depth0 * float(pc.step) + 1e-4))
                * exp(-abs(luminance(light) - light0) / (light0 + 0.05));
            sum += light * w;
            weights += w;
        }
    }

    vec3 filtered = sum / max(weights, 1e-6);
    imageStore(hdrOut, p, vec4(mix(filtered, center.rgb, settled), center.a));
}

// Downsamples the bright parts of the image
void bloomExtract(ivec2 p) {
    ivec2 size = imageSize(hdrIn);
    vec3 sum = vec3(0);
    for (int y = 0; y < BLOOM_SCALE; y++) {
        for (int x = 0; x < BLOOM_SCALE; x++) {
            ivec2 q = min(p * BLOOM_SCALE + ivec2(x, y), size - 1);
            vec3 c = colorAt(q, imageLoad(hdrIn, q).rgb) * EXPOSURE;
            sum += c * smoothstep(BLOOM_THRESHOLD * 0.8, BLOOM_THRESHOLD * 2.0, luminance(c));
        }
    }
    imageStore(bloomOut, p, vec4(sum / (BLOOM_SCALE * BLOOM_SCALE), 1));
}

// Gaussian blur along one axis, with taps spread out for a wider glow
void bloomBlur(ivec2 p, ivec2 axis) {
    const float WEIGHTS[5] = float[5](0.2270, 0.1945, 0.1216, 0.0540, 0.0162);
    ivec2 size = imageSize(bloomIn);
    vec3 sum = imageLoad(bloomIn, p).rgb * WEIGHTS[0];
    for (int i = 1; i < 5; i++) {
        ivec2 offset = axis * i * 2;
        sum += imageLoad(bloomIn, clamp(p + offset, ivec2(0), size - 1)).rgb * WEIGHTS[i];
        sum += imageLoad(bloomIn, clamp(p - offset, ivec2(0), size - 1)).rgb * WEIGHTS[i];
    }
    imageStore(bloomOut, p, vec4(sum, 1));
}

vec3 sampleBloom(ivec2 p) {
    ivec2 size = imageSize(bloomIn);
    vec2 pos = (vec2(p) + 0.5) / BLOOM_SCALE - 0.5;
    ivec2 i = ivec2(floor(pos));
    vec2 f = fract(pos);
    vec3 a = imageLoad(bloomIn, clamp(i, ivec2(0), size - 1)).rgb;
    vec3 b = imageLoad(bloomIn, clamp(i + ivec2(1, 0), ivec2(0), size - 1)).rgb;
    vec3 c = imageLoad(bloomIn, clamp(i + ivec2(0, 1), ivec2(0), size - 1)).rgb;
    vec3 d = imageLoad(bloomIn, clamp(i + ivec2(1, 1), ivec2(0), size - 1)).rgb;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void tonemap(ivec2 p) {
    vec3 color = colorAt(p, imageLoad(hdrIn, p).rgb);
    color += sampleBloom(p) * pc.bloom;

    color = max(mix(vec3(luminance(color)), color, RICHNESS), 0);
    vec3 mapped = aces(color * EXPOSURE);
    mapped = clamp(mix(vec3(luminance(mapped)), mapped, SATURATION), 0, 1);

    if ((pc.flags & POST_GRADE) != 0) {
        // Deeper mid tones, cool shadows, warm highlights, and darker corners
        mapped = pow(mapped, vec3(CONTRAST));
        mapped *= mix(vec3(0.94, 1.0, 1.08), vec3(1.07, 1.0, 0.9), smoothstep(0.1, 0.8, luminance(mapped)));
        vec2 uv = (vec2(p) + 0.5) / vec2(imageSize(hdrIn)) * 2 - 1;
        mapped *= 1 - 0.22 * dot(uv, uv);
    }

    if ((pc.flags & POST_ENCODE_SRGB) != 0)
    mapped = linearToSrgb(clamp(mapped, 0, 1));
    imageStore(targetImage, p, vec4(mapped, 1));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (pc.stage == DENOISE || pc.stage == TONEMAP) {
        if (any(greaterThanEqual(p, imageSize(hdrIn))))
        return;
        if (pc.stage == DENOISE)
        denoise(p);
        else
        tonemap(p);
    } else {
        if (any(greaterThanEqual(p, imageSize(bloomOut))))
        return;
        if (pc.stage == BLOOM_EXTRACT)
        bloomExtract(p);
        else
        bloomBlur(p, pc.stage == BLOOM_BLUR_X ? ivec2(1, 0) : ivec2(0, 1));
    }
}
