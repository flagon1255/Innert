// Has to match the material ids in src\worldgen.rs
const uint MAT_CRYSTAL = 56;
const uint MAT_FLAME = 57;
const uint MAT_STEEL = 69;
const uint MAT_BRONZE = 72;
const uint MAT_GLOW_FIRE = 79;
const uint MAT_GLOW_HOLY = 86;

// Light given off by glowing materials
vec3 emission(uint material) {
    if (material == MAT_FLAME)
    return vec3(6.0, 3.2, 1.2);
    if (material == MAT_CRYSTAL)
    return vec3(0.5, 1.6, 2.2);
    if (material >= MAT_GLOW_FIRE && material <= MAT_GLOW_HOLY)
    return pow(PALETTE[material], vec3(2.2)) * 3.0;
    return vec3(0);
}

// https://www.shadertoy.com/view/WlfXRN
vec3 inferno(float t) {
    const vec3 c0 = vec3(0.0002189403691192265, 0.001651004631001012, -0.01948089843709184);
    const vec3 c1 = vec3(0.1065134194856116, 0.5639564367884091, 3.932712388889277);
    const vec3 c2 = vec3(11.60249308247187, -3.972853965665698, -15.9423941062914);
    const vec3 c3 = vec3(-41.70399613139459, 17.43639888205313, 44.35414519872813);
    const vec3 c4 = vec3(77.162935699427, -33.40235894210092, -81.80730925738993);
    const vec3 c5 = vec3(-71.31942824499214, 32.62606426397723, 73.20951985803202);
    const vec3 c6 = vec3(25.13112622477341, -12.24266895238567, -23.07032500287172);

    return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
}

vec3 stepsToInferno(uint steps, uint start, uint end) {
    float t = float(int(steps - start)) / (end - start);
    return inferno(clamp(t, 0, 1));
}

// https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
uint hash(uint x) {
    uint state = x * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint hash(uvec3 v) {
    return hash(v.x ^ hash(v.y ^ hash(v.z)));
}

float random(inout uint seed) {
    seed = hash(seed);
    return float(seed >> 8) / 16777216.0;
}

uvec3 levelSize(uint level) {
    return level == NEAR ? pc.near_size.xyz : pc.world_size.xyz;
}

uint brickCell(uint level, ivec3 brick) {
    return level == NEAR ? imageLoad(nearGrid, brick).r : imageLoad(brickGrid, brick).r;
}

uint brickWord(uint level, uint index) {
    return level == NEAR ? nearBricks[index] : bricks[index];
}

// Whether a voxel of a stored brick is solid, `cell` being its brick grid cell
bool brickVoxel(uint level, uint cell, uvec3 local_coord) {
    uint i = local_coord.x + local_coord.y * 8 + local_coord.z * 64;
    return bool(brickWord(level, ((cell & BRICK_INDEX) - 1) * BRICK_WORDS + i / 32) >> (i % 32) & 1u);
}

bool isSolid(uint level, ivec3 coord) {
    if (any(lessThan(coord, ivec3(0))) || any(greaterThanEqual(coord, ivec3(levelSize(level)))))
    return false;
    uint cell = brickCell(level, coord / 8);
    if ((cell & EMPTY_BRICK) != 0)
    return false;
    if ((cell & SOLID_BRICK) != 0)
    return true;
    return brickVoxel(level, cell, uvec3(coord % 8));
}

uint brickMaterial(uint level, uint cell, uvec3 local_coord) {
    uint i = local_coord.x + local_coord.y * 8 + local_coord.z * 64;
    return brickWord(level, ((cell & BRICK_INDEX) - 1) * BRICK_WORDS + 16 + i / 4) >> ((i % 4) * 8) & 0xFFu;
}

// Only valid for solid voxels
uint materialAt(uint level, uvec3 coord) {
    uint cell = brickCell(level, ivec3(coord / 8));
    if ((cell & SOLID_BRICK) != 0)
    return cell & 0xFFu;
    return brickMaterial(level, cell, coord % 8);
}

bool nearActive() {
    return pc.near_origin.w > 0;
}

// Positions in voxels of the main world to voxels of the box around the camera, and back
vec3 toNear(vec3 p) {
    return (p - pc.near_origin.xyz) * pc.near_origin.w;
}

vec3 fromNear(vec3 p) {
    return p / pc.near_origin.w + pc.near_origin.xyz;
}

bool insideNear(vec3 p) {
    vec3 q = toNear(p);
    return nearActive() && all(greaterThanEqual(q, vec3(0))) && all(lessThan(q, vec3(pc.near_size.xyz)));
}

vec3 materialAlbedo(uint material, uvec3 coord) {
    vec3 color = pow(PALETTE[min(material, PALETTE_SIZE - 1)], vec3(2.2));
    // Every voxel is a slightly different shade, so the voxels show even on flat ground. Clumps of
    // voxels vary a little too, and over larger patches the color drifts warmer or cooler.
    float fine = float(hash(coord) & 0xFFu) / 255.0;
    float clump = float(hash(coord / 4 + 7919u) & 0xFFu) / 255.0;
    float region = float(hash(coord / 16 + 104729u) & 0xFFu) / 255.0;
    color *= mix(vec3(1.06, 1.0, 0.9), vec3(0.94, 1.0, 1.08), region);
    return color * (0.86 + 0.18 * fine + 0.10 * clump);
}

const float FLT_MAX = 3.4028235e+38;

struct Hit {
    uint level;
    uint instance; // Which animal, for hits on one
    uvec3 coord; // In voxels of that level, or of the animal's model
    uint axis; // Axis of the face the ray entered through
    vec3 normal;
    vec3 local_normal; // The normal in the animal's own voxels, the same as normal for the world
    float t; // Distance along the (normalized) ray
    ivec3 shift; // For leaves blown aside by the wind, how far from where they grow, see voxelHit()
};

// Whether a ray stops at this voxel of a stored brick
bool brickHit(uint level, uint cell, uvec3 local_coord, bool through_water) {
    if (!brickVoxel(level, cell, local_coord))
    return false;
    return !through_water || brickMaterial(level, cell, local_coord) != MAT_WATER;
}

// Has to match sways() in src\worldgen.rs
bool sways(uint material) {
    return material == 8u || (material >= 13u && material <= 16u) || material == 23u || material == 27u || material == 29u
        || material == 30u || material == 35u || material == 67u || material == 12u || material == 9u || material == 10u
        || material == 17u || material == 18u || material == 25u || material == 26u;
}

// Leaves only sway this many meters from the camera, as further off it's too small to see and
// costs as much as near by
const float SWAY_REACH = 30.0;
// Only for what the camera sees: shadows and bounce light come from the leaves as they grow,
// as tracing those rays through swaying leaves too costs much more
bool g_sway = true;

// How far leaves and flowers at `p`, in voxels of the main world, are blown aside right now: a
// voxel either way along x and y, or not at all. A wind blowing mostly along x rolls across the
// land in waves and gusts, the same over a patch of voxels, so a whole bit of a tree crown leans
// over together.
ivec3 sway(vec3 p) {
    // In meters across the whole landscape, so it carries on when the world moves on
    p = (p + vec3(pc.window.xy, 0)) / float(max(pc.world_size.w, 1u));
    float t = pc.haze.y;
    float gust = 0.65 + 0.35 * sin(t * 0.21 + p.x * 0.013);
    float wave = sin(p.x * 0.55 + p.y * 0.25 - t * 1.9 + p.z * 0.4) + 0.45 * sin(p.y * 0.7 - p.x * 0.2 - t * 3.1);
    vec2 d = vec2(1.0, 0.45) * wave * gust;
    return ivec3(round(d), 0);
}

// Whether a ray stops at a voxel of a stored brick, `cell` being the cell of its `brick`. Where
// leaves sway, a voxel holds the leaves blown into it from beside rather than its own, which may
// have blown away; `shift` is then where they came from.
bool voxelHit(uint level, uint cell, ivec3 brick, uvec3 coord, bool through_water, out ivec3 shift) {
    shift = ivec3(0);
    uvec3 local = coord % 8;
    bool here = brickHit(level, cell, local, through_water);
    if ((cell & FOLIAGE_BRICK) == 0 || (pc.flags & FLAG_WIND) == 0 || !g_sway)
    return here;
    vec3 p = level == NEAR ? fromNear(vec3(coord)) : vec3(coord);
    vec3 to_camera = p - pc.pixelToRay[3].xyz;
    float reach = SWAY_REACH * float(max(pc.world_size.w, 1u));
    if (dot(to_camera, to_camera) > reach * reach)
    return here;
    ivec3 d = sway(p);
    if (d == ivec3(0))
    return here;
    if (here && !sways(brickMaterial(level, cell, local)))
    return true;
    ivec3 from = ivec3(coord) - d;
    if (any(lessThan(from, ivec3(0))) || any(greaterThanEqual(from, ivec3(levelSize(level)))))
    return false;
    uint from_cell = from / 8 == brick ? cell : brickCell(level, from / 8);
    if ((from_cell & (EMPTY_BRICK | SOLID_BRICK)) != 0)
    return false;
    if (!brickVoxel(level, from_cell, uvec3(from % 8)) || !sways(brickMaterial(level, from_cell, uvec3(from % 8))))
    return false;
    shift = d;
    return true;
}

// Traces a ray through one level, in that level's voxels.
// With through_water, rays pass through water as if it were air.
// Rays give up after max_distance, and ignore anything solid closer than ignore_until.
bool traverse(uint level, vec3 origin, vec3 dir, bool through_water, float max_distance, float ignore_until, out Hit hit, inout uint steps) {
    hit.level = level;
    hit.instance = 0;
    vec3 size = vec3(levelSize(level));
    vec3 inv_dir = 1. / dir;
    vec3 sgn_dir = sign(inv_dir);
    inv_dir = clamp(inv_dir, vec3(-FLT_MAX), vec3(FLT_MAX));

    vec3 t1 = -origin * inv_dir;
    vec3 t2 = (size - origin) * inv_dir;

    vec3 tmins = min(t1, t2);
    vec3 tmaxs = max(t1, t2);

    float tmin = 0;
    float tmax = FLT_MAX;
    for (int i = 0; i < 3; i++) {
        tmin = max(tmin, tmins[i]);
        tmax = min(tmax, tmaxs[i]);
    }

    if (tmin > tmax || tmin > max_distance) {
        return false;
    }
    // Measured from where the ray enters the grid, like the rest of the t values below
    max_distance -= tmin;
    ignore_until -= tmin;

    // The ray enters the grid through the slab it reaches last
    uint brick_axis;
    if (tmins.x > tmins.y) {
        brick_axis = tmins.x > tmins.z ? 0 : 2;
    } else {
        brick_axis = tmins.y > tmins.z ? 1 : 2;
    }

    // From here on t is measured from where the ray enters the grid
    origin += dir * tmin;

    // Outer traversal over bricks, skipping empty ones in a single step
    ivec3 brick_count = ivec3(size) / 8;
    ivec3 brick = clamp(ivec3(floor(origin / 8)), ivec3(0), brick_count - 1);
    ivec3 brick_step = ivec3(sgn_dir);
    vec3 brick_t = ((brick + 0.5 * (1 + sgn_dir)) * 8 - origin) * inv_dir;
    vec3 brick_delta = 8 * inv_dir * sgn_dir;
    float brick_enter = 0;

    uvec3 ustep = uvec3(ivec3(sgn_dir));
    vec3 delta = inv_dir * sgn_dir;

    while (true) {
        steps++;

        uint cell = brickCell(level, brick);
        uint empty_distance = (cell & EMPTY_BRICK) != 0 ? cell & 0xFFFFu : 0;
        if (empty_distance > 1) {
            // Every brick within empty_distance - 1 of this one is empty, so jump
            // straight to where the ray leaves that cube
            ivec3 reach = ivec3(empty_distance - 1);
            vec3 t_lo = (vec3((brick - reach) * 8) - origin) * inv_dir;
            vec3 t_hi = (vec3((brick + reach + 1) * 8) - origin) * inv_dir;
            vec3 t_exit = max(t_lo, t_hi);

            uint axis = t_exit.x < t_exit.y ? (t_exit.x < t_exit.z ? 0 : 2) : (t_exit.y < t_exit.z ? 1 : 2);
            brick_enter = t_exit[axis];
            brick_axis = axis;

            ivec3 next = clamp(ivec3(floor((origin + dir * brick_enter) / 8)), brick - reach, brick + reach);
            next[axis] = brick[axis] + brick_step[axis] * int(empty_distance);
            brick = next;
            brick_t = ((brick + 0.5 * (1 + sgn_dir)) * 8 - origin) * inv_dir;

            if (any(lessThan(brick, ivec3(0))) || any(greaterThanEqual(brick, brick_count)) || brick_enter > max_distance)
            return false;
            continue;
        }
        if (empty_distance == 0 && !(through_water && cell == (SOLID_BRICK | MAT_WATER))) {
            vec3 p = origin + dir * brick_enter;
            uvec3 coord = uvec3(clamp(ivec3(floor(p)), brick * 8, brick * 8 + 7));
            uint stepped_axis = brick_axis;
            float enter = brick_enter;

            bool solid_brick = (cell & SOLID_BRICK) != 0;
            ivec3 shift = ivec3(0);
            bool found = (solid_brick || voxelHit(level, cell, brick, coord, through_water, shift)) && enter >= ignore_until;
            if (!found) {
                // Inner traversal over the voxels of this brick
                vec3 t = (coord + 0.5 * (1 + sgn_dir) - origin) * inv_dir;
                while (true) {
                    steps++;

                    if (t.x < t.y) {
                        if (t.x < t.z) {
                            coord.x += ustep.x;
                            enter = t.x;
                            t.x += delta.x;
                            stepped_axis = 0;
                        } else {
                            coord.z += ustep.z;
                            enter = t.z;
                            t.z += delta.z;
                            stepped_axis = 2;
                        }
                    } else {
                        if (t.y < t.z) {
                            coord.y += ustep.y;
                            enter = t.y;
                            t.y += delta.y;
                            stepped_axis = 1;
                        } else {
                            coord.z += ustep.z;
                            enter = t.z;
                            t.z += delta.z;
                            stepped_axis = 2;
                        }
                    }

                    // Stepping below 0 wraps around, which also leaves the brick
                    if (any(notEqual(coord / 8, uvec3(brick))))
                    break;
                    if ((solid_brick || voxelHit(level, cell, brick, coord, through_water, shift)) && enter >= ignore_until) {
                        found = true;
                        break;
                    }
                }
            }

            if (found) {
                vec3 mask = vec3(0);
                mask[stepped_axis] = 1;

                hit.coord = coord;
                hit.axis = stepped_axis;
                hit.normal = -mask * sgn_dir;
                hit.local_normal = hit.normal;
                hit.t = tmin + enter;
                hit.shift = shift;
                return true;
            }
        }

        if (brick_t.x < brick_t.y) {
            if (brick_t.x < brick_t.z) {
                brick.x += brick_step.x;
                brick_enter = brick_t.x;
                brick_t.x += brick_delta.x;
                brick_axis = 0;
            } else {
                brick.z += brick_step.z;
                brick_enter = brick_t.z;
                brick_t.z += brick_delta.z;
                brick_axis = 2;
            }
        } else {
            if (brick_t.y < brick_t.z) {
                brick.y += brick_step.y;
                brick_enter = brick_t.y;
                brick_t.y += brick_delta.y;
                brick_axis = 1;
            } else {
                brick.z += brick_step.z;
                brick_enter = brick_t.z;
                brick_t.z += brick_delta.z;
                brick_axis = 2;
            }
        }

        if (any(lessThan(brick, ivec3(0))) || any(greaterThanEqual(brick, brick_count)) || brick_enter > max_distance)
        return false;
    }
}

uint animalCount() {
    return pc.near_size.w;
}

uvec3 modelSize(uint model) {
    uint packed = animalModels[model * 2 + 1];
    return uvec3(packed & 0x3FFu, (packed >> 10) & 0x3FFu, (packed >> 20) & 0x3FFu);
}

// Material of one of a model's voxels, 0 for air
uint modelVoxel(uint model, uvec3 size, uvec3 c) {
    uint i = c.x + (c.y + c.z * size.y) * size.x;
    return animalModels[animalModels[model * 2] + i / 4] >> ((i % 4) * 8) & 0xFFu;
}

vec3 rotate(vec4 q, vec3 v) {
    vec3 t = 2 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

// Turns a direction in the world into the way an animal faces, and back
vec3 toAnimal(Animal a, vec3 v) {
    return rotate(vec4(-a.rotation.xyz, a.rotation.w), v);
}

vec3 fromAnimal(Animal a, vec3 v) {
    return rotate(a.rotation, v);
}

// A point in an animal's voxels, in voxels of the main world
vec3 animalToWorld(uint index, vec3 p) {
    Animal a = animals[index];
    uvec3 size = modelSize(a.info.x);
    return a.position.xyz + fromAnimal(a, (p - vec3(vec2(size.xy) * 0.5, 0)) * a.scale.x);
}

// Rays besides those from the camera only check this many animals and props, the nearest to the
// camera, as checking every one for every shadow and bounce costs too much
const uint SECONDARY_ANIMALS = 24;
uint g_animal_limit = 0xFFFFFFFFu;

// The nearest animal a ray hits before max_t, in voxels of the main world. The ray is turned and
// scaled into each animal's voxels, without normalizing it, so distances along it stay the same.
bool traceAnimals(vec3 origin, vec3 dir, float max_t, inout Hit hit) {
    bool found = false;
    uint count = min(animalCount(), g_animal_limit);
    // Rays from the camera see what's held in front of anything else
    bool from_camera = g_animal_limit == 0xFFFFFFFFu;
    for (uint i = 0; i < count; i++) {
        Animal a = animals[i];
        float limit = from_camera && a.info.y == HELD ? FLT_MAX : max_t;
        // Only animals whose bounding sphere the ray passes through
        vec3 to = a.position.xyz - origin;
        float along = dot(to, dir);
        float radius = a.position.w;
        if (along < -radius || along - radius > limit || dot(to, to) - along * along > radius * radius)
        continue;

        uint model = a.info.x;
        uvec3 size = modelSize(model);
        float s = a.scale.x;
        vec3 o = toAnimal(a, -to) / s + vec3(vec2(size.xy) * 0.5, 0);
        vec3 d = toAnimal(a, dir) / s;
        vec3 inv = clamp(1 / d, vec3(-FLT_MAX), vec3(FLT_MAX));
        vec3 t1 = -o * inv;
        vec3 t2 = (vec3(size) - o) * inv;
        vec3 tmins = min(t1, t2);
        vec3 tmaxs = max(t1, t2);
        float t = max(max(tmins.x, tmins.y), max(tmins.z, 0));
        float t_exit = min(min(tmaxs.x, tmaxs.y), tmaxs.z);
        if (t > t_exit || t > limit)
        continue;

        uint axis = tmins.x > tmins.y ? (tmins.x > tmins.z ? 0 : 2) : (tmins.y > tmins.z ? 1 : 2);
        vec3 sgn = sign(d);
        ivec3 c = clamp(ivec3(floor(o + d * t)), ivec3(0), ivec3(size) - 1);
        vec3 next = (vec3(c) + max(sgn, vec3(0)) - o) * inv;
        vec3 delta = abs(inv);
        for (int k = 0; k < 512 && t <= limit; k++) {
            if (modelVoxel(model, size, uvec3(c)) != 0) {
                vec3 local_normal = vec3(0);
                local_normal[axis] = -sgn[axis];
                hit.level = ANIMAL;
                hit.instance = i;
                hit.coord = uvec3(c);
                hit.axis = axis;
                hit.local_normal = local_normal;
                hit.normal = fromAnimal(a, local_normal);
                hit.t = t;
                hit.shift = ivec3(0);
                max_t = t;
                found = true;
                break;
            }
            if (next.x < next.y && next.x < next.z) {
                axis = 0;
                t = next.x;
                next.x += delta.x;
            } else if (next.y < next.z) {
                axis = 1;
                t = next.y;
                next.y += delta.y;
            } else {
                axis = 2;
                t = next.z;
                next.z += delta.z;
            }
            c[axis] += int(sgn[axis]);
            if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(size))))
            break;
        }
    }
    return found;
}

// Traces a ray in voxels of the main world. Rays starting in the box around the camera go through
// its finer voxels first, then carry on in the main world from where they leave it. Animals are
// checked last, and win if they're nearer.
bool traceWorld(vec3 origin, vec3 dir, bool through_water, float max_distance, out Hit hit, inout uint steps);

bool trace(vec3 origin, vec3 dir, bool through_water, float max_distance, out Hit hit, inout uint steps) {
    bool found = traceWorld(origin, dir, through_water, max_distance, hit, steps);
    if (animalCount() > 0 && traceAnimals(origin, dir, found ? hit.t : max_distance, hit))
    found = true;
    return found;
}

bool traceWorld(vec3 origin, vec3 dir, bool through_water, float max_distance, out Hit hit, inout uint steps) {
    float start = 0;
    float ignore_until = 0;
    if (insideNear(origin)) {
        float s = pc.near_origin.w;
        if (traverse(NEAR, toNear(origin), dir, through_water, max_distance * s, 0, hit, steps)) {
            hit.t /= s;
            return true;
        }
        vec3 inv_dir = clamp(1 / dir, vec3(-FLT_MAX), vec3(FLT_MAX));
        vec3 lo = pc.near_origin.xyz;
        vec3 hi = lo + vec3(pc.near_size.xyz) / s;
        vec3 t_exit = max((lo - origin) * inv_dir, (hi - origin) * inv_dir);
        start = min(t_exit.x, min(t_exit.y, t_exit.z));
        if (start > max_distance)
        return false;
        // The coarser ground at the edge of the box can stick up above the finer ground the ray
        // just passed over, so don't let it stop the ray right where it comes out
        ignore_until = 1.5;
    }
    if (traverse(MAIN, origin + dir * start, dir, through_water, max_distance - start, ignore_until, hit, steps)) {
        hit.t += start;
        return true;
    }
    return false;
}

// A hit's position in voxels of its own level
vec3 levelPosition(Hit hit, vec3 position) {
    return hit.level == NEAR ? toNear(position) : position;
}

// A point inside a hit voxel, in voxels of the main world
vec3 voxelPoint(Hit hit, vec3 local) {
    vec3 p = vec3(hit.coord) + local;
    return hit.level == NEAR ? fromNear(p) : p;
}

float daylight() {
    return smoothstep(-0.1, 0.25, pc.sun_direction.z);
}

vec3 sunColor() {
    float elevation = pc.sun_direction.z;
    // Golden low in the sky, never quite white
    vec3 color = mix(vec3(1.0, 0.45, 0.2), vec3(1.0, 0.9, 0.78), smoothstep(0.0, 0.65, elevation));
    return color * 2.4 * smoothstep(-0.02, 0.06, elevation);
}

vec3 skyColor(vec3 dir) {
    // A deep, saturated blue
    vec3 zenith = vec3(0.08, 0.3, 0.92);
    // Warmer horizon around sunrise and sunset
    vec3 horizon = mix(vec3(0.9, 0.55, 0.35), vec3(0.55, 0.74, 0.98), smoothstep(0.0, 0.35, pc.sun_direction.z));
    vec3 sky = mix(horizon, zenith, sqrt(clamp(dir.z, 0, 1)));
    sky = mix(sky, horizon * 0.4, clamp(-dir.z * 4.0, 0, 1));
    return sky * mix(0.02, 1.0, daylight());
}

vec3 sunDisc(vec3 dir) {
    float d = max(dot(dir, pc.sun_direction.xyz), 0);
    return sunColor() * (pow(d, 2000.0) * 50.0 + pow(d, 12.0) * 0.15);
}

// Cheap stand-in for light from the sky and the ground, used when bounce light is off
vec3 ambientLight(vec3 normal) {
    vec3 sky = 0.5 * (skyColor(vec3(0, 0, 1)) + skyColor(normalize(vec3(1, 0, 0.2))));
    vec3 ground = vec3(0.3, 0.27, 0.2) * (sunColor() * 0.15 + sky * 0.3);
    return mix(ground, sky, normal.z * 0.5 + 0.5);
}

// Cosine-weighted sunlight on a surface, 0 when it's in shadow
float sunLight(vec3 surface, vec3 normal) {
    vec3 sun = pc.sun_direction.xyz;
    float n_dot_l = dot(normal, sun);
    if (n_dot_l <= 0 || sun.z < -0.02)
    return 0;
    if ((pc.flags & FLAG_SHADOWS) != 0) {
        Hit hit;
        uint steps = 0;
        if (trace(surface, sun, true, FLT_MAX, hit, steps))
        return 0;
    }
    return n_dot_l;
}

// Light on a surface from the flames and crystals near it, with their shadows
vec3 localLight(vec3 surface, vec3 normal) {
    vec3 total = vec3(0);
    uint count = uint(pc.haze.z);
    float vpm = float(max(pc.world_size.w, 1u));
    for (uint i = 0; i < count; i++) {
        Light light = lights[i];
        vec3 to = light.position.xyz - surface;
        float d = length(to);
        if (d > light.position.w || d < 1e-3)
        continue;
        vec3 dir = to / d;
        float n_dot_l = dot(normal, dir);
        if (n_dot_l <= 0)
        continue;
        if ((pc.flags & FLAG_SHADOWS) != 0) {
            Hit blocker;
            uint steps = 0;
            // Stopping short of the light, so the candle it's on doesn't shade it
            if (trace(surface, dir, true, d - 0.35 * vpm, blocker, steps))
            continue;
        }
        float meters = d / vpm;
        float fade = 1 - smoothstep(0.5, 1.0, d / light.position.w);
        total += light.color.rgb * n_dot_l * fade / (0.3 + meters * meters);
    }
    return total;
}

float vertexAO(bool side1, bool side2, bool corner) {
    if (side1 && side2)
    return 0;
    return (3 - float(side1) - float(side2) - float(corner)) / 3;
}

// The material of what a ray hit, in the world or on an animal
uint hitMaterial(Hit hit) {
    if (hit.level == ANIMAL) {
        uint model = animals[hit.instance].info.x;
        return modelVoxel(model, modelSize(model), hit.coord);
    }
    // Leaves blown aside are still the leaves they were where they grow
    return materialAt(hit.level, uvec3(ivec3(hit.coord) - hit.shift));
}

vec3 hitAlbedo(Hit hit, uint material) {
    // Animals each get their own variation, and leaves blown aside keep theirs
    return materialAlbedo(material, hit.level == ANIMAL ? hit.coord + uvec3(hit.instance * 7919u) : uvec3(ivec3(hit.coord) - hit.shift));
}

// What weapons did to an animal shows on it: burning or poisoned, frozen or crackling with
// lightning. Tints its albedo, and returns the light it gives off.
vec3 tintAnimal(Hit hit, inout vec3 albedo) {
    if (hit.level != ANIMAL)
    return vec3(0);
    uint tint = animals[hit.instance].info.z;
    // A few voxels at a time flare up, different ones every few frames
    float flare = float(hash(hit.coord + uvec3(0, 0, uint(pc.haze.y * 14.0) * 31u)) & 0xFFu) / 255.0;
    flare = flare * flare * flare;
    if (tint == TINT_BURNING) {
        albedo *= 0.45;
        return vec3(3.0, 1.1, 0.25) * (0.15 + 2.0 * flare);
    }
    if (tint == TINT_FROZEN)
    albedo = mix(albedo, vec3(0.45, 0.72, 0.95), 0.75);
    if (tint == TINT_CHILLED)
    albedo = mix(albedo, vec3(0.45, 0.72, 0.95), 0.3);
    if (tint == TINT_POISONED) {
        albedo = mix(albedo, vec3(0.12, 0.42, 0.06), 0.45);
        return vec3(0.3, 1.0, 0.15) * 0.6 * flare;
    }
    if (tint == TINT_SHOCKED)
    return vec3(1.4, 1.8, 3.2) * 2.0 * flare;
    return vec3(0);
}

// Whether a voxel next to a hit one is solid, in the same voxels as the hit
bool solidBeside(Hit hit, ivec3 c) {
    if (hit.level == ANIMAL) {
        uint model = animals[hit.instance].info.x;
        uvec3 size = modelSize(model);
        if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(size))))
        return false;
        return modelVoxel(model, size, uvec3(c)) != 0;
    }
    return isSolid(hit.level, c);
}

// Ambient occlusion from the 8 voxels around the hit face. It's the same over the whole face,
// so every voxel is shaded as one flat patch and the voxels stay crisp.
float voxelAO(Hit hit) {
    ivec3 base = ivec3(hit.coord) + ivec3(hit.local_normal);
    uint ua = (hit.axis + 1) % 3;
    uint va = (hit.axis + 2) % 3;
    ivec3 du = ivec3(0);
    du[ua] = 1;
    ivec3 dv = ivec3(0);
    dv[va] = 1;

    bool u0 = solidBeside(hit, base - du);
    bool u1 = solidBeside(hit, base + du);
    bool v0 = solidBeside(hit, base - dv);
    bool v1 = solidBeside(hit, base + dv);

    float a00 = vertexAO(u0, v0, solidBeside(hit, base - du - dv));
    float a10 = vertexAO(u1, v0, solidBeside(hit, base + du - dv));
    float a01 = vertexAO(u0, v1, solidBeside(hit, base - du + dv));
    float a11 = vertexAO(u1, v1, solidBeside(hit, base + du + dv));

    return mix(0.2, 1.0, (a00 + a10 + a01 + a11) * 0.25);
}

// Which way the surface a voxel is part of faces, from which of the voxels around it are empty.
// Every face of the voxel is lit with it, so each voxel is one flat color and surfaces shade
// smoothly across them, as in John Lin's engine, rather than every side of every cube being lit
// on its own. Thin things like leaves and blades of grass lean on the face's own direction.
vec3 voxelNormal(Hit hit) {
    ivec3 c = ivec3(hit.coord);
    vec3 n = vec3(0);
    for (int z = -1; z <= 1; z++) {
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                ivec3 o = ivec3(x, y, z);
                if (o != ivec3(0) && !solidBeside(hit, c + o))
                n += vec3(o) / length(vec3(o));
            }
        }
    }
    n += hit.local_normal * 0.8;
    n = length(n) > 1e-3 ? normalize(n) : hit.local_normal;
    return hit.level == ANIMAL ? fromAnimal(animals[hit.instance], n) : n;
}

// The middle of the face a ray hit, nudged just out of the voxel, in voxels of the main world.
// Light is worked out there instead of where the ray hit, so a face is lit the same all over:
// shadows and bounce light come in steps of whole voxels.
vec3 faceCenter(Hit hit) {
    vec3 p = vec3(hit.coord) + 0.5 + hit.local_normal * 0.502;
    if (hit.level == ANIMAL)
    return animalToWorld(hit.instance, p);
    return hit.level == NEAR ? fromNear(p) : p;
}

// Which way a face points, for the denoiser: 0-5
float faceId(vec3 normal);

// A random seed shared by every pixel that sees the same face, so they all get the same
// bounce light each frame, new every frame
uint faceSeed(Hit hit) {
    uint face = uint(faceId(hit.local_normal)) + hit.level * 8 + hit.instance * 32;
    return hash(uvec3(hit.coord.x, hit.coord.y ^ hash(face), hit.coord.z ^ hash(pc.frame)));
}

// White water churns a voxel at a time: down the sides of a waterfall streaks of lighter and
// darker voxels fall at a few meters a second, and on top the voxels flicker
float foamFlow(Hit hit) {
    float time = pc.haze.y;
    uvec3 c = hit.coord;
    float vpm = float(max(pc.world_size.w, 1u)) * (hit.level == NEAR ? pc.near_origin.w : 1);
    if (abs(hit.local_normal.z) < 0.5) {
        // Ribbons a few voxels long, each column falling at its own pace
        uint offset = hash(c.x * 7919u + c.y);
        uint fallen = uint(time * (4.0 + float(offset & 3u)) * vpm);
        uint streak = hash(uvec3(c.x, c.y, (c.z + fallen + (offset >> 4 & 15u)) / 5u));
        return 0.5 + 0.65 * float(streak & 0xFFu) / 255;
    }
    uint tick = uint(time * 4.0) + (hash(c.x * 31u + c.y) & 3u);
    return 0.82 + 0.25 * float(hash(uvec3(c.xy, c.z ^ tick)) & 0xFFu) / 255;
}

// Set while shading what a pixel sees directly if it moves, so the pixel doesn't average it over
// many frames and smear it
bool g_dynamic = false;
// Set when what a pixel sees is held in front of the camera, so it's in the same place on screen
// as last frame rather than in the world
bool g_held = false;

// The light cache entry for a face of the world, made if `make` and there isn't one yet.
// NO_ENTRY if there's none, or no room for it.
uint cacheEntry(Hit hit, bool make) {
    if (hit.level == ANIMAL)
    return NO_ENTRY;
    ivec3 corner = ivec3(pc.window.xy, 0);
    if (hit.level == NEAR)
    corner = ivec3(round((pc.near_origin.xyz + vec3(corner)) * pc.near_origin.w));
    uvec3 at = uvec3(ivec3(hit.coord) + corner);
    uint face = uint(faceId(hit.local_normal)) + hit.level * 8u;
    uint h = hash(uvec3(at.x ^ (face << 27), at.y, at.z));
    uint key = hash(h ^ 0x9e3779b9u) | 1u;
    uint entries = uint(cache.length()) / CACHE_WORDS;
    for (uint i = 0; i < CACHE_PROBES; i++) {
        uint e = ((h + i) % entries) * CACHE_WORDS;
        uint k = cache[e];
        if (k == key)
        return e;
        if (!make)
        continue;
        // Empty, or not seen for a while
        if (k == 0 || pc.frame - cache[e + 5] > 3000u) {
            uint was = atomicCompSwap(cache[e], k, key);
            if (was == k) {
                cache[e + 1] = 0;
                cache[e + 2] = 0;
                cache[e + 3] = 0;
                cache[e + 4] = 0;
                cache[e + 5] = pc.frame;
                return e;
            }
            if (was == key)
            return e;
        }
    }
    return NO_ENTRY;
}

// The light gathered at a cache entry so far, and how many samples went into it
vec3 cachedLight(uint e, out uint samples) {
    samples = cache[e + 4];
    return vec3(cache[e + 1], cache[e + 2], cache[e + 3]) / CACHE_SCALE / float(max(samples, 1u));
}

// Adds a sample of bounced light to a cache entry. Once it has plenty, half of what it has is
// forgotten, so newer light counts for more.
void cacheAdd(uint e, vec3 light) {
    uvec3 add = uvec3(clamp(light, vec3(0), vec3(16)) * CACHE_SCALE);
    atomicAdd(cache[e + 1], add.x);
    atomicAdd(cache[e + 2], add.y);
    atomicAdd(cache[e + 3], add.z);
    uint samples = atomicAdd(cache[e + 4], 1u) + 1;
    if (samples >= 4 * CACHE_SAMPLES && atomicCompSwap(cache[e + 4], samples, samples / 2) == samples) {
        cache[e + 1] /= 2;
        cache[e + 2] /= 2;
        cache[e + 3] /= 2;
    }
}

// `dir` turned out of the face with normal `face`, if it pointed into it
vec3 outward(vec3 dir, vec3 face) {
    return dot(dir, face) < 0 ? reflect(dir, face) : dir;
}

vec3 cosineDirection(vec3 normal, inout uint seed) {
    float z = random(seed) * 2 - 1;
    float a = random(seed) * 6.28318530718;
    float r = sqrt(1 - z * z);
    vec3 dir = normal + vec3(r * cos(a), r * sin(a), z);
    float len = length(dir);
    return len > 1e-4 ? dir / len : normal;
}

// Single-bounce shading for reflections and bounce light
vec3 shadeSecondary(vec3 origin, vec3 dir, bool include_sun, float max_distance) {
    Hit hit;
    uint steps = 0;
    if (!trace(origin, dir, false, max_distance, hit, steps))
    return skyColor(dir) + (include_sun ? sunDisc(dir) : vec3(0));

    uint material = hitMaterial(hit);
    vec3 albedo = hitAlbedo(hit, material);
    // Glowing things that move, like a spell flying, would leave their light behind in the light
    // cache. Their light reaches what's around them as one of the lights instead.
    vec3 glow = hit.level == ANIMAL && animals[hit.instance].info.y != STILL ? vec3(0) : emission(material);
    // The light already gathered on the face it hit, when there is some, which bounces light on
    // round corners and into caves
    vec3 bounced = ambientLight(hit.normal);
    uint e = (pc.flags & FLAG_GI) != 0 ? cacheEntry(hit, false) : NO_ENTRY;
    uint samples = 0;
    if (e != NO_ENTRY) {
        vec3 cached = cachedLight(e, samples);
        if (samples >= 4)
        bounced = cached;
    }
    return albedo * (sunColor() * sunLight(faceCenter(hit), hit.normal) + bounced) + glow;
}

// How much light survives travelling this many voxels through water
vec3 waterTransmittance(float distance) {
    float meters = distance / float(max(pc.world_size.w, 1u));
    return exp(-meters * vec3(0.45, 0.10, 0.08));
}

// Light scattered back out by deep water
vec3 waterScatter() {
    return vec3(0.02, 0.14, 0.15) * (sunColor() * 0.5 + ambientLight(vec3(0, 0, 1)));
}

float waterFresnel(vec3 dir, vec3 normal) {
    return 0.02 + 0.98 * pow(1 - max(dot(-dir, normal), 0), 5);
}

// The sea outside the world: the same water over a flat sandy bottom
vec3 shadeOpenSea(vec3 dir, vec3 pos) {
    vec3 up = vec3(0, 0, 1);
    vec3 reflection = shadeSecondary(pos + up * 1e-3, reflect(dir, up), true, REFLECTION_REACH * float(max(pc.world_size.w, 1u)));

    vec3 refracted = refract(dir, up, 1 / 1.33);
    float depth = SEABED_DEPTH * float(max(pc.world_size.w, 1u));
    vec3 transmittance = waterTransmittance(depth / max(-refracted.z, 0.05));
    vec3 sand = pow(PALETTE[MAT_SAND], vec3(2.2));
    vec3 seabed = sand * (sunColor() * max(pc.sun_direction.z, 0) + ambientLight(up) * 0.6) * transmittance;
    vec3 refraction = seabed * transmittance + waterScatter() * (1 - transmittance);

    return mix(refraction, reflection, waterFresnel(dir, up));
}

// Clear water: a reflection on top of the refracted view of whatever is under it
vec3 shadeWater(vec3 dir, vec3 pos, vec3 normal) {
    float fresnel = waterFresnel(dir, normal);
    vec3 reflection = shadeSecondary(pos + normal * 1e-3, reflect(dir, normal), true, REFLECTION_REACH * float(max(pc.world_size.w, 1u)));
    vec3 scatter = waterScatter();

    vec3 below = pos - normal * 1e-3;
    vec3 refracted = refract(dir, normal, 1 / 1.33);
    Hit hit;
    uint steps = 0;
    vec3 refraction = scatter;
    if (trace(below, refracted, true, FLT_MAX, hit, steps)) {
        uint material = hitMaterial(hit);
        vec3 albedo = hitAlbedo(hit, material);
        vec3 transmittance = waterTransmittance(hit.t);
        vec3 face = faceCenter(hit);
        // Sunlight reaching the bottom crossed about as much water as the view does
        vec3 lit = (albedo * (sunColor() * sunLight(face, hit.normal) + ambientLight(hit.normal) * 0.6 + localLight(face, hit.normal)) + emission(material)) * transmittance;
        refraction = lit * transmittance + scatter * (1 - transmittance);
    }

    return mix(refraction, reflection, fresnel);
}

// The water in a column of the main world fills whole voxels, from the top of the ground up to
// `top`, so it's made of voxels like everything else. False where it's dry.
bool waterColumn(ivec2 c, out float bottom, out float top, out float foam) {
    vec2 s = imageLoad(waterSurface, c).xy;
    bottom = imageLoad(waterGround, c).r;
    top = floor(s.x + 0.5);
    foam = s.y;
    return top > bottom;
}

bool hasWater() {
    return (pc.flags & FLAG_WATER) != 0;
}

// Whether a point (in voxels of the main world) is in water
bool isWater(vec3 p) {
    ivec2 c = ivec2(floor(p.xy));
    if (!hasWater() || any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, imageSize(waterGround))))
    return false;
    float bottom, top, foam;
    return waterColumn(c, bottom, top, foam) && p.z < top && p.z > bottom - 1;
}

struct WaterHit {
    float t;
    Hit voxel; // The water voxel the ray entered, for lighting it like any other
    float foam;
    bool falling; // Through the air, off a ledge
};

// Where a ray crossing a column between tc and tc_end first gets into water reaching from bottom to
// top, both whole voxels: in through the side it came by (if it came in by a side), down through the
// top, or up through the bottom. `face` says which: 0, 1 or 2.
bool enterWater(vec3 origin, vec3 dir, float tc, float tc_end, float bottom, float top, bool from_side, out float t, out int face) {
    t = FLT_MAX;
    face = 0;
    if (top <= bottom)
    return false;
    float za = origin.z + dir.z * tc;
    float zb = origin.z + dir.z * tc_end;
    if (from_side && za > bottom && za < top) {
        t = tc;
        return true;
    }
    if (za >= top && zb < top) {
        t = (top - origin.z) / dir.z;
        face = 1;
        return true;
    }
    if (za <= bottom && zb > bottom) {
        t = (bottom - origin.z) / dir.z;
        face = 2;
        return true;
    }
    return false;
}

// Where a ray first enters the water before max_t, from above or the side. It walks over blocks of
// columns first, skipping those whose water it passes over, then over the columns of the rest.
bool traceWater(vec3 origin, vec3 dir, float max_t, out WaterHit hit) {
    hit.t = FLT_MAX;
    if (!hasWater())
    return false;
    ivec2 size = imageSize(waterGround);
    vec2 inv = clamp(1 / dir.xy, vec2(-FLT_MAX), vec2(FLT_MAX));
    vec2 ta = -origin.xy * inv;
    vec2 tb = (vec2(size) - origin.xy) * inv;
    vec2 t_in = min(ta, tb);
    float t = max(max(t_in.x, t_in.y), 0);
    float t_end = min(min(max(ta.x, tb.x), max(ta.y, tb.y)), max_t);
    // Nothing is above the top of the world
    if (dir.z > 0)
    t_end = min(t_end, (float(pc.world_size.z) - origin.z) / dir.z);
    if (t >= t_end)
    return false;

    vec2 sgn = sign(dir.xy);
    vec2 delta = abs(inv);
    ivec2 blocks = (size + WATER_BLOCK - 1) / WATER_BLOCK;
    // Which way the ray came into the current block and column, -1 if it started inside
    int axis = t > 0 ? (t_in.x > t_in.y ? 0 : 1) : -1;
    ivec2 block = clamp(ivec2(floor((origin.xy + dir.xy * t) / WATER_BLOCK)), ivec2(0), blocks - 1);
    vec2 next = ((vec2(block) + max(sgn, vec2(0))) * WATER_BLOCK - origin.xy) * inv;

    for (int b = 0; b < 1024 && t < t_end; b++) {
        float block_end = min(min(next.x, next.y), t_end);
        float highest = imageLoad(waterBlocks, block).r;
        float z_low = min(origin.z + dir.z * t, origin.z + dir.z * block_end);
        if (highest >= 0 && z_low < highest + 0.5) {
            ivec2 lo = block * WATER_BLOCK;
            ivec2 c = clamp(ivec2(floor(origin.xy + dir.xy * t)), lo, min(lo + WATER_BLOCK, size) - 1);
            vec2 cnext = (vec2(c) + max(sgn, vec2(0)) - origin.xy) * inv;
            float tc = t;
            int caxis = axis;
            for (int k = 0; k < 2 * WATER_BLOCK + 2 && tc < block_end; k++) {
                float tc_end = min(min(cnext.x, cnext.y), block_end);
                // Each column can have water lying in it, and water falling through it off a ledge
                vec4 s = imageLoad(waterSurface, c);
                float ground = imageLoad(waterGround, c).r;
                bool from_side = caxis >= 0 && tc > 0;
                float t_pool, t_fall;
                int face_pool, face_fall;
                bool pool = enterWater(origin, dir, tc, tc_end, ground, floor(s.x + 0.5), from_side, t_pool, face_pool) && face_pool != 2;
                bool fall = enterWater(origin, dir, tc, tc_end, floor(s.z + 0.5), floor(s.w + 0.5), from_side, t_fall, face_fall);
                if (pool || fall) {
                    fall = fall && (!pool || t_fall < t_pool);
                    int face = fall ? face_fall : face_pool;
                    hit.t = fall ? t_fall : t_pool;
                    hit.foam = fall ? 1 : s.y;
                    hit.falling = fall;
                    vec3 normal = vec3(0, 0, face == 1 ? 1 : -1);
                    float z;
                    if (face == 0) {
                        normal = vec3(0);
                        normal[caxis] = -sgn[caxis];
                        z = floor(origin.z + dir.z * tc);
                    } else if (face == 1) {
                        z = floor((fall ? s.w : s.x) + 0.5) - 1;
                    } else {
                        z = floor(s.z + 0.5);
                    }
                    hit.voxel.level = MAIN;
                    hit.voxel.instance = 0;
                    hit.voxel.coord = uvec3(c, max(z, 0));
                    hit.voxel.axis = face == 0 ? caxis : 2;
                    hit.voxel.normal = normal;
                    hit.voxel.local_normal = normal;
                    hit.voxel.t = hit.t;
                    hit.voxel.shift = ivec3(0);
                    return true;
                }
                if (cnext.x < cnext.y) {
                    tc = cnext.x;
                    cnext.x += delta.x;
                    c.x += int(sgn.x);
                    caxis = 0;
                } else {
                    tc = cnext.y;
                    cnext.y += delta.y;
                    c.y += int(sgn.y);
                    caxis = 1;
                }
                if (any(lessThan(c, lo)) || any(greaterThanEqual(c, min(lo + WATER_BLOCK, size))))
                break;
            }
        }
        if (next.x < next.y) {
            t = next.x;
            next.x += WATER_BLOCK * delta.x;
            block.x += int(sgn.x);
            axis = 0;
        } else {
            t = next.y;
            next.y += WATER_BLOCK * delta.y;
            block.y += int(sgn.y);
            axis = 1;
        }
        if (any(lessThan(block, ivec2(0))) || any(greaterThanEqual(block, blocks)))
        break;
    }
    return false;
}

// Which way the top of the water in a column faces. Each voxel's top is flat, but tilted a little
// with the slope of the water around it, so waves catch the light one voxel at a time.
vec3 waterTilt(ivec2 c) {
    ivec2 size = imageSize(waterSurface);
    float h = imageLoad(waterSurface, c).x;
    float s[4];
    const ivec2 dirs[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    for (int i = 0; i < 4; i++) {
        ivec2 n = clamp(c + dirs[i], ivec2(0), size - 1);
        float sn = imageLoad(waterSurface, n).x;
        // Dry neighbors and falling sheets don't count
        s[i] = abs(sn - h) < 2 ? sn : h;
    }
    return normalize(vec3((s[0] - s[1]) * 0.5, (s[2] - s[3]) * 0.5, 1));
}

// Materials thin enough to let sunlight through, one bit per material id. Has to match the
// material ids in src\worldgen.rs: leaves (8, 13-16), pine (23), fern (27), grass blades and tips
// (22, 12), flowers (9, 10, 17, 18, 25, 26), blossom (29), willow (30), reed (33), palm leaf (35)
const uint FOLIAGE_LOW = (1u << 8) | (1u << 13) | (1u << 14) | (1u << 15) | (1u << 16) | (1u << 23) | (1u << 27)
    | (1u << 22) | (1u << 12) | (1u << 9) | (1u << 10) | (1u << 17) | (1u << 18) | (1u << 25) | (1u << 26)
    | (1u << 29) | (1u << 30);
const uint FOLIAGE_HIGH = (1u << (33 - 32)) | (1u << (35 - 32));

// Has to match the material ids in src\worldgen.rs: dry grass (65), cactus (66), vines (67)
const uint MAT_DRY_GRASS = 65;
const uint MAT_VINE = 67;

bool isFoliage(uint material) {
    if (material >= 64)
    return material == MAT_DRY_GRASS || material == MAT_VINE;
    return material < 32 ? (FOLIAGE_LOW & (1u << material)) != 0 : (FOLIAGE_HIGH & (1u << (material - 32))) != 0;
}

// Sunlight shining through a leaf from behind, brightest when looking towards the sun
vec3 leafTransmission(Hit hit, vec3 dir, vec3 albedo) {
    vec3 sun = pc.sun_direction.xyz;
    float behind = -dot(hit.normal, sun);
    if (behind <= 0 || sun.z < -0.02)
    return vec3(0);
    // Only if sunlight reaches the leaf's other side, starting just past it
    if ((pc.flags & FLAG_SHADOWS) != 0) {
        Hit blocker;
        uint steps = 0;
        if (trace(voxelPoint(hit, 0.5 + sun * 0.9), sun, true, FLT_MAX, blocker, steps))
        return vec3(0);
    }
    float towards_sun = pow(max(dot(dir, sun), 0), 4);
    // Light coming through is filtered by the leaf twice over, so it comes out more saturated
    return albedo * albedo * 2.5 * sunColor() * TRANSLUCENCY * (0.3 + 0.7 * behind) * (0.4 + 1.6 * towards_sun);
}

// The sun map is an orthographic view of the world along the sunlight, from a plane outside it
void sunMapBasis(out vec3 u, out vec3 v, out vec3 center, out float radius) {
    vec3 sun = pc.sun_direction.xyz;
    vec3 helper = abs(sun.z) < 0.99 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    u = normalize(cross(helper, sun));
    v = cross(sun, u);
    center = vec3(pc.world_size.xyz) * 0.5;
    radius = length(vec3(pc.world_size.xyz)) * 0.5;
}

// Whether sunlight reaches a point in the air, from the sun map
float sunMapLight(vec3 p, vec3 u, vec3 v, vec3 center, float radius) {
    vec3 offset = p - center;
    vec2 uv = vec2(dot(offset, u), dot(offset, v)) / radius * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0))) || any(greaterThanEqual(uv, vec2(1))))
    return 1;
    float along = radius - dot(offset, pc.sun_direction.xyz);
    float blocked_at = imageLoad(sunMap, ivec2(uv * SUN_MAP_SIZE)).r;
    return along < blocked_at + 2 * radius / SUN_MAP_SIZE ? 1 : 0;
}

// Henyey-Greenstein phase function times 4 pi, so it averages 1 over all directions.
// Haze scatters light mostly onwards, so it glows most looking towards the sun.
float hazePhase(float cos_angle) {
    const float g = 0.5;
    return (1 - g * g) / pow(1 + g * g - 2 * g * cos_angle, 1.5);
}

// Haze between the camera and what it sees, thicker near the ground. It dims what's behind it and
// glows with the light it scatters: sunlight, except where the sun map says something casts a
// shadow into the air, which is what makes sunbeams, plus light from the sky.
// How much of what's behind the haze atmosphere() last let through, 0-1
float g_transmittance = 1;

vec3 atmosphere(vec3 origin, vec3 dir, float distance, vec3 color, inout uint seed) {
    g_transmittance = 1;
    float density = pc.haze.x;
    if (density <= 0)
    return color;
    float vpm = float(max(pc.world_size.w, 1u));
    float reach = HAZE_REACH * vpm;
    if (distance >= 0)
    reach = min(reach, distance);

    vec3 u, v, center;
    float radius;
    sunMapBasis(u, v, center, radius);
    bool beams = (pc.flags & FLAG_SUNBEAMS) != 0;
    vec3 sun_light = sunColor() * hazePhase(dot(dir, pc.sun_direction.xyz)) * 0.3;
    vec3 sky_light = ambientLight(vec3(0, 0, 1)) * 0.8;
    float sea_level = pc.sun_direction.w;

    float step_length = reach / HAZE_SAMPLES;
    float offset = random(seed);
    float transmittance = 1;
    vec3 scattered = vec3(0);
    for (int i = 0; i < HAZE_SAMPLES; i++) {
        vec3 p = origin + dir * (float(i) + offset) * step_length;
        float height = max(p.z - sea_level, 0) / vpm;
        float thickness = density * exp(-height / HAZE_HEIGHT) * step_length / vpm;
        float lit = beams ? sunMapLight(p, u, v, center, radius) : 1;
        scattered += transmittance * (sun_light * lit + sky_light) * thickness;
        transmittance *= exp(-thickness);
    }
    g_transmittance = transmittance;
    return color * transmittance + scattered;
}

// Which way a face points, for the denoiser: 0-5
float faceId(vec3 normal) {
    vec3 a = abs(normal);
    float axis = a.x > 0.5 ? 0 : (a.y > 0.5 ? 1 : 2);
    return axis * 2 + (dot(normal, vec3(1)) > 0 ? 1 : 0);
}

struct GrassHit {
    float t;
    vec3 normal;
    float height; // 0 at the root, 1 at the tip
    uint seed;
};

// Grass density (0-1) at a column of the main world, and the height of the ground there in voxels
float grassAt(ivec2 column, out float ground) {
    ground = 0;
    if (any(lessThan(column, ivec2(0))) || any(greaterThanEqual(column, ivec2(pc.world_size.xy))))
    return 0;
    uint value = imageLoad(grassMap, column).r;
    ground = float(value & 0xFFFFu) * 0.25;
    return float((value >> 16) & 0xFFu) / 255;
}

// Möller–Trumbore, from either side. `along` is how far the hit is towards c.
bool rayTriangle(vec3 origin, vec3 dir, vec3 a, vec3 b, vec3 c, out float t, out float along) {
    t = 0;
    along = 0;
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 p = cross(dir, ac);
    float det = dot(ab, p);
    if (abs(det) < 1e-8)
    return false;
    float inv = 1 / det;
    vec3 s = origin - a;
    float u = dot(s, p) * inv;
    if (u < 0 || u > 1)
    return false;
    vec3 q = cross(s, ab);
    float v = dot(dir, q) * inv;
    if (v < 0 || u + v > 1)
    return false;
    t = dot(ac, q) * inv;
    along = v;
    return t > 0;
}

// Grass made of triangles, one per blade, rooted on grassy ground. Blades are made up from a hash
// of the patch of ground they grow in, so they take no memory. The ray walks over the patches it
// passes above, and only tests the blades of the ones where it's low enough to touch them.
bool traceGrass(vec3 origin, vec3 dir, float max_t, out GrassHit hit) {
    float vpm = float(max(pc.world_size.w, 1u));
    float cell = GRASS_CELL * vpm;
    float tallest = GRASS_HEIGHT * vpm;
    float range = GRASS_RANGE * vpm;

    vec2 o = origin.xy / cell;
    vec2 d = dir.xy / cell;
    ivec2 c = ivec2(floor(o));
    vec2 sgn = sign(d);
    vec2 inv = clamp(1 / d, vec2(-FLT_MAX), vec2(FLT_MAX));
    vec2 next = (vec2(c) + max(sgn, vec2(0)) - o) * inv;
    vec2 delta = abs(inv);

    hit.t = min(max_t, range);
    hit.normal = vec3(0, 0, 1);
    hit.height = 0;
    hit.seed = 0;
    bool found = false;
    float t0 = 0;
    for (int i = 0; i < 512 && t0 < hit.t; i++) {
        float t1 = min(min(next.x, next.y), hit.t);
        float z0 = origin.z + dir.z * t0;
        float z1 = origin.z + dir.z * t1;
        float ground;
        float density = grassAt(ivec2((vec2(c) + 0.5) * cell), ground);
        if (density > 0 && min(z0, z1) < ground + tallest && max(z0, z1) > ground - cell) {
            // Thinner further away
            float fade = 1 - smoothstep(0.5, 1.0, t0 / range);
            int count = int(float(GRASS_PER_CELL) * density * fade + 0.5);
            for (int k = 0; k < count; k++) {
                uint seed = hash(uvec3(uvec2(c), uint(k)));
                vec2 base = (vec2(c) + 0.15 + 0.7 * vec2(random(seed), random(seed))) * cell;
                float root;
                grassAt(ivec2(floor(base)), root);
                float height = mix(0.4, 1.0, random(seed)) * tallest * mix(0.7, 1.0, density);
                float width = mix(0.025, 0.045, random(seed)) * vpm;
                float facing = random(seed) * 6.28318530718;
                vec2 side = vec2(cos(facing), sin(facing)) * width * 0.5;
                float lean_angle = random(seed) * 6.28318530718;
                vec2 lean = vec2(cos(lean_angle), sin(lean_angle)) * random(seed) * 0.08 * vpm;

                vec3 a = vec3(base + side, root - 0.05 * vpm);
                vec3 b = vec3(base - side, root - 0.05 * vpm);
                vec3 tip = vec3(base + lean, root + height);
                float t, along;
                if (rayTriangle(origin, dir, a, b, tip, t, along) && t < hit.t) {
                    hit.t = t;
                    hit.normal = normalize(cross(b - a, tip - a));
                    hit.height = along;
                    hit.seed = seed;
                    found = true;
                }
            }
        }

        // On to the next patch
        if (next.x < next.y) {
            t0 = next.x;
            next.x += delta.x;
            c.x += int(sgn.x);
        } else {
            t0 = next.y;
            next.y += delta.y;
            c.y += int(sgn.y);
        }
    }
    return found;
}

vec3 shadeGrass(vec3 origin, vec3 dir, GrassHit grass, inout vec4 guide) {
    vec3 pos = origin + dir * grass.t;
    vec3 normal = dot(grass.normal, dir) > 0 ? -grass.normal : grass.normal;
    uint seed = grass.seed;
    float h = clamp(grass.height, 0, 1);

    // Dark at the root, lighter and yellower towards the tip, a little different blade to blade
    vec3 tip_color = mix(vec3(0.11, 0.29, 0.04), vec3(0.25, 0.34, 0.06), random(seed));
    vec3 albedo = mix(vec3(0.02, 0.06, 0.01), tip_color, smoothstep(0.0, 0.9, h)) * mix(0.8, 1.15, random(seed));
    // Less light gets down between the blades
    float occlusion = mix(0.2, 1.0, h);

    vec3 sun = pc.sun_direction.xyz;
    float visible = sun.z > -0.02 ? 1 : 0;
    if (visible > 0 && (pc.flags & FLAG_SHADOWS) != 0) {
        Hit blocker;
        uint steps = 0;
        if (trace(pos + normal * 0.02, sun, true, FLT_MAX, blocker, steps))
        visible = 0;
    }
    // Light falls on both sides of a blade, and shines through it towards the camera
    float facing = abs(dot(normal, sun)) * mix(0.5, 1.0, h);
    float through = (pow(max(dot(dir, sun), 0), 3) * 1.5 + 0.25) * TRANSLUCENCY;
    vec3 light = sunColor() * visible * (facing + through) + ambientLight(normal) * occlusion;

    // The denoiser leaves grass alone, there's no noise in it to smooth out
    guide = vec4(albedo, 7);
    return albedo * light;
}

// Seen from under water, everything fades into the water's color
vec3 shadeUnderwater(vec3 origin, vec3 dir, inout uint steps, out float distance) {
    Hit hit;
    vec3 color;
    float path;
    if (trace(origin, dir, true, FLT_MAX, hit, steps)) {
        vec3 albedo = hitAlbedo(hit, hitMaterial(hit));
        color = albedo * (sunColor() * sunLight(faceCenter(hit), hit.normal) + ambientLight(hit.normal) * 0.6);
        path = hit.t;
        distance = hit.t;
    } else {
        color = skyColor(dir);
        float bottom, top, foam;
        waterColumn(ivec2(floor(origin.xy)), bottom, top, foam);
        path = dir.z > 0 && top > origin.z ? (top - origin.z) / dir.z : 1e6;
        distance = -1;
    }
    vec3 transmittance = waterTransmittance(path);
    return color * transmittance + waterScatter() * (1 - transmittance);
}

vec3 shadeSurface(vec3 origin, vec3 dir, inout uint seed, inout uint steps, out float distance, inout vec4 guide);

// `distance` is how far along the ray the visible surface is, -1 for the sky.
// `guide` is what the denoiser needs, see guideImage.
vec3 shade(vec3 origin, vec3 dir, inout uint seed, inout uint steps, out float distance, out vec4 guide) {
    guide = vec4(1, 1, 1, 7);
    if (isWater(origin))
    return shadeUnderwater(origin, dir, steps, distance);

    vec3 color = shadeSurface(origin, dir, seed, steps, distance, guide);
    color = atmosphere(origin, dir, distance, color, seed);
    float kept = g_transmittance;
    // Only so much of the endless landscape is there at once, so things fade into the sky well
    // before its edge
    float fade_end = pc.haze.w;
    if (fade_end > 0 && distance >= 0) {
        float fade = smoothstep(0.7 * fade_end, fade_end, distance);
        color = mix(color, skyColor(normalize(vec3(dir.xy, max(dir.z, 0.02)))), fade);
        kept *= 1 - fade;
    }
    // Only as much of the color as still shows through the haze goes with the voxel's color,
    // otherwise far off, where the jitter lands on different voxels every frame, the haze would
    // flicker with them
    guide.rgb = mix(vec3(1), max(guide.rgb, vec3(0.03)), kept);
    return color;
}

// Water voxels: clear water with reflections and the bottom showing through, or where it's flowing
// fast or falling, churned up white
vec3 shadeWaterVoxel(vec3 origin, vec3 dir, WaterHit water) {
    g_dynamic = true;
    vec3 pos = origin + dir * water.t;
    Hit voxel = water.voxel;
    vec3 face = voxel.normal.z > 0.5 && water.foam < 1 ? waterTilt(ivec2(voxel.coord.xy)) : voxel.normal;
    vec3 color = shadeWater(dir, pos, face);
    if (water.foam > 0.01) {
        float flow = foamFlow(voxel);
        // Darker streaks in falling water are where it's less churned up, so they're bluer
        vec3 albedo = pow(mix(vec3(0.55, 0.75, 0.85), PALETTE[MAT_FOAM], clamp(flow - 0.4, 0, 1)), vec3(2.2)) * min(flow, 1);
        vec3 face_center = faceCenter(voxel);
        vec3 lit = albedo * (sunColor() * sunLight(face_center, voxel.normal) + ambientLight(voxel.normal) + localLight(face_center, voxel.normal));
        // Falling water is churned white right through. Fast water on the surface just has white
        // on top, with the clear water showing through.
        color = mix(color, lit, water.falling ? 1.0 : water.foam * 0.75);
    }
    return color;
}

vec3 shadeSurface(vec3 origin, vec3 dir, inout uint seed, inout uint steps, out float distance, inout vec4 guide) {
    Hit hit;
    bool solid = trace(origin, dir, false, FLT_MAX, hit, steps);
    g_animal_limit = SECONDARY_ANIMALS;
    g_sway = false;
    // Leaves blown aside are lit as they are where they grow, so their light and shade move with
    // them rather than flickering as they sway in and out of the shade of others
    if (solid && hit.shift != ivec3(0)) {
        hit.coord = uvec3(ivec3(hit.coord) - hit.shift);
        hit.shift = ivec3(0);
    }
    WaterHit water;
    bool wet = traceWater(origin, dir, solid ? hit.t : FLT_MAX, water);

    GrassHit grass;
    if ((pc.flags & FLAG_GRASS) != 0 && traceGrass(origin, dir, wet ? water.t : (solid ? hit.t : FLT_MAX), grass)) {
        distance = grass.t;
        return shadeGrass(origin, dir, grass, guide);
    }

    if (wet) {
        distance = water.t;
        // The denoiser leaves water alone
        guide = vec4(1, 1, 1, 7);
        return shadeWaterVoxel(origin, dir, water);
    }

    if (!solid) {
        float sea_level = pc.sun_direction.w;
        float t = (sea_level - origin.z) / dir.z;
        if (sea_level > 0 && dir.z < 0 && t > 0) {
            distance = t;
            return shadeOpenSea(dir, origin + dir * t);
        }
        distance = -1;
        guide.w = 6;
        return skyColor(dir) + sunDisc(dir);
    }
    distance = hit.t;

    vec3 pos = origin + dir * hit.t;
    vec3 normal = hit.normal;
    uint material = hitMaterial(hit);

    // Seen through the side of the world, the water at its edge continues the open sea
    bool world_edge = hit.level == MAIN
        && (any(equal(hit.coord.xy, uvec2(0))) || any(equal(hit.coord.xy, pc.world_size.xy - 1)));
    float sea_level = pc.sun_direction.w;
    if (material == MAT_WATER && world_edge && normal.z < 0.5 && sea_level > 0 && dir.z < 0) {
        float t = (sea_level - origin.z) / dir.z;
        distance = t;
        return shadeOpenSea(dir, origin + dir * t);
    }

    vec3 color;
    if (material == MAT_WATER && hit.level != ANIMAL) {
        color = shadeWater(dir, pos, normal);
    } else {
        vec3 albedo = hitAlbedo(hit, material);
        vec3 glow = tintAnimal(hit, albedo) + emission(material);
        if (material == MAT_FOAM && hit.level != ANIMAL) {
            albedo *= foamFlow(hit);
            g_dynamic = true;
        }
        if (hit.level == ANIMAL && animals[hit.instance].info.y != STILL)
        g_dynamic = true;
        // Leaves move in the wind, so they can't be averaged over many frames
        if ((pc.flags & FLAG_WIND) != 0 && hit.level != ANIMAL && sways(material))
        g_dynamic = true;
        bool held = hit.level == ANIMAL && animals[hit.instance].info.y == HELD;
        if (held)
        g_held = true;
        // The ground under the grass is in its shade, out to where the grass thins out
        if (material == MAT_GRASS && (pc.flags & FLAG_GRASS) != 0) {
            float range = GRASS_RANGE * float(max(pc.world_size.w, 1u));
            albedo *= mix(0.35, 1.0, smoothstep(0.5 * range, range, hit.t));
        }
        float ao = (pc.flags & FLAG_AO) != 0 ? voxelAO(hit) : 1;
        vec3 face = faceCenter(hit);
        if ((pc.flags & FLAG_SMOOTH) != 0)
        normal = voxelNormal(hit);

        vec3 indirect;
        // What's held moves with the camera, so it'd only show the noise of one bounce a frame:
        // it gets steady light from the sky and ground instead
        if ((pc.flags & FLAG_GI) != 0 && !held) {
            float reach = BOUNCE_DISTANCE * float(max(pc.world_size.w, 1u));
            uint e = cacheEntry(hit, true);
            if (e != NO_ENTRY) {
                // Light bounced onto this face, gathered over many frames. Faces new to the cache
                // take a sample from every pixel that sees them, so they fill in fast, and after
                // that only the odd one.
                cache[e + 5] = pc.frame;
                uint samples;
                indirect = cachedLight(e, samples);
                if (samples < CACHE_SAMPLES || random(seed) < 1.0 / 64.0) {
                    vec3 light = shadeSecondary(face, outward(cosineDirection(normal, seed), hit.normal), false, reach);
                    cacheAdd(e, light);
                    indirect = (indirect * float(samples) + light) / float(samples + 1);
                }
            } else {
                // One random diffuse bounce per face per frame, averaging frames smooths out the noise
                uint face_seed = faceSeed(hit);
                indirect = shadeSecondary(face, outward(cosineDirection(normal, face_seed), hit.normal), false, reach);
            }
            indirect *= mix(1, ao, 0.5);
        } else if (held) {
            // Greyer than the sky, as the world round it would bounce plenty of warmer light
            vec3 around = ambientLight(normal);
            indirect = mix(around, vec3(dot(around, vec3(0.333))), 0.5) * 0.8 * ao;
        } else {
            indirect = ambientLight(normal) * ao;
        }

        float sun = sunLight(face, normal);
        // Metal is darker than it looks, as most of its shine is reflection: it glints where it
        // catches the sun, and mirrors what's around it
        vec3 shine = vec3(0);
        if (material >= MAT_STEEL && material <= MAT_BRONZE) {
            vec3 r = reflect(dir, normal);
            // Light metal reflects much more than dark, and colored metal in its own color
            float reflectance = dot(albedo, vec3(0.2126, 0.7152, 0.0722));
            vec3 tint = mix(vec3(1), albedo / max(max(albedo.r, albedo.g), max(albedo.b, 1e-3)), 0.7) * reflectance;
            float glint = sun > 0 ? pow(max(dot(r, pc.sun_direction.xyz), 0), 24.0) * 4.0 : 0;
            float reach = REFLECTION_DISTANCE * float(max(pc.world_size.w, 1u));
            vec3 around = shadeSecondary(face + hit.normal * 0.05, outward(r, hit.normal), false, reach);
            shine = tint * (sunColor() * glint + mix(around, vec3(dot(around, vec3(0.333))), 0.3) * 0.6 * ao);
            albedo *= 0.6;
        }
        color = albedo * (sunColor() * sun + indirect + localLight(face, normal)) + glow + shine;
        if (isFoliage(material))
        color += leafTransmission(hit, dir, albedo);
        guide = vec4(albedo, faceId(hit.normal));
    }

    return color;
}

float halton(uint i, uint base) {
    float f = 1;
    float r = 0;
    while (i > 0) {
        f /= float(base);
        r += f * float(i % base);
        i /= base;
    }
    return r;
}

// Where within its pixel each ray goes through this frame, -0.5 to 0.5. Has to match upscale.comp.
vec2 pixelJitter(uint frame) {
    uint i = frame % 16 + 1;
    return vec2(halton(i, 2), halton(i, 3)) - 0.5;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    if (pc.render_mode == SUN_MAP) {
        if (any(greaterThanEqual(pixelCoord, ivec2(SUN_MAP_SIZE))))
        return;
        vec3 u, v, center;
        float radius;
        sunMapBasis(u, v, center, radius);
        vec2 uv = (vec2(pixelCoord) + 0.5) / SUN_MAP_SIZE * 2 - 1;
        vec3 sun = pc.sun_direction.xyz;
        vec3 start = center + (u * uv.x + v * uv.y + sun) * radius;
        Hit hit;
        uint steps = 0;
        float blocked_at = traverse(MAIN, start, -sun, true, FLT_MAX, 0, hit, steps) ? hit.t : 1e30;
        imageStore(sunMap, pixelCoord, vec4(blocked_at));
        return;
    }

    ivec2 imageSize = imageSize(targetImage);

    if (any(greaterThanEqual(pixelCoord, imageSize)))
    return;

    vec3 o = pc.pixelToRay[3].xyz;
    uint steps = 0;

    if (pc.render_mode == SHADED) {
        uint seed = hash(uvec3(pixelCoord, pc.frame));
        // Every ray goes through the same spot within its pixel, a different one each frame, which
        // upscale.comp gathers into a sharper image than any one frame
        vec2 jitter = pixelJitter(pc.frame);
        vec3 ray = mat3(pc.pixelToRay) * vec3(pixelCoord + jitter, 1);
        vec3 d = normalize(ray);

        float distance;
        vec4 guide;
        vec3 color = shade(o, d, seed, steps, distance, guide);
        // Distance along the unnormalized ray, which is what previousWorldToPixel gives as z next frame
        float depth = distance >= 0 ? distance / length(ray) : -1;
        // So the upscaler knows to keep what's held where it is on screen
        if (g_held)
        guide.w += 8;
        // It's the light that's averaged over frames, not the voxels' colors: those are taken fresh
        // each frame, as the jitter sees different voxels at the edges between them. post.comp
        // puts them back.
        color /= guide.rgb;

        // Find what this surface looked like last frame
        vec4 history = vec4(0);
        bool still = pc.history_limit >= 1024; // The view hasn't changed at all
        if (still) {
            history = imageLoad(historyColor, pixelCoord);
        } else if (g_held && pc.history_limit > 0) {
            if (abs(imageLoad(historyDepth, pixelCoord).r - depth) < 0.03 * depth)
            history = imageLoad(historyColor, pixelCoord);
        } else if (pc.history_limit > 0 && depth >= 0) {
            vec4 p = pc.previousWorldToPixel * vec4(o + d * distance, 1);
            ivec2 previous = ivec2(floor(p.xy / p.z + 0.5));
            if (p.z > 0 && all(greaterThanEqual(previous, ivec2(0))) && all(lessThan(previous, imageSize))) {
                // Only if it's the same surface, not something in front of it that moved out of the way
                float previous_depth = imageLoad(historyDepth, previous).r;
                if (abs(previous_depth - p.z) < 0.03 * p.z)
                history = imageLoad(historyColor, previous);
            }
        }
        float limit = max(float(pc.history_limit), 1);
        // Things that move only keep the last few frames
        if (g_dynamic)
        limit = min(limit, 3);
        float count = min(history.a + 1, limit);
        color = mix(history.rgb, color, 1 / count);
        imageStore(accumColor, pixelCoord, vec4(color, count));
        imageStore(accumDepth, pixelCoord, vec4(depth));
        imageStore(guideImage, pixelCoord, guide);
        return;
    }

    vec3 d = normalize(mat3(pc.pixelToRay) * vec3(pixelCoord, 1));

    Hit hit;
    bool did_hit = trace(o, d, false, FLT_MAX, hit, steps);

    if (pc.render_mode == STEPS) {
        uint max_steps = (pc.world_size.x + pc.world_size.y + pc.world_size.z) / 8;
        imageStore(targetImage, pixelCoord, vec4(stepsToInferno(steps, 0, max_steps), 1));
        return;
    }

    if (!did_hit)
    return;

    vec3 color;
    switch (pc.render_mode) {
        case COORD:
        color = vec3(hit.coord) / vec3(levelSize(hit.level) - 1);
        break;
        case NORMAL:
        vec3 normal = hit.normal;
        color = max(normal.xyz, 0) - min(normal.yxz + normal.zyx, 0);
        break;
        case UV:
        vec3 local_hit = levelPosition(hit, o + d * hit.t) - vec3(hit.coord);
        vec2 uv;
        if (hit.axis == 0) {
            uv = local_hit.yz;
        } else if (hit.axis == 1) {
            uv = local_hit.xz;
        } else {
            uv = local_hit.xy;
        }
        color = vec3(uv, 0);
        break;
        case DEPTH:
        float max_size = float(max(max(pc.world_size.x, pc.world_size.y), pc.world_size.z));
        color = vec3(1 / (1 + hit.t / max_size)) + vec3(0.3, 0.0, 0.7) / 256;
        break;
    }
    imageStore(targetImage, pixelCoord, vec4(color, 1));
}
