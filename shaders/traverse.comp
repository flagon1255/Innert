const uint SHADED = 0;
const uint COORD = 1;
const uint STEPS = 2;
const uint NORMAL = 3;
const uint UV = 4;
const uint DEPTH = 5;
// Not a view: fills in the sun map, one invocation per texel. Has to match SUN_MAP_MODE in main.rs
const uint SUN_MAP = 100;

// Has to match the FLAG_* constants in main.rs
const uint FLAG_SHADOWS = 1;
const uint FLAG_AO = 2;
const uint FLAG_GI = 4;
const uint FLAG_SUNBEAMS = 8;
const uint FLAG_GRASS = 16;
const uint FLAG_WATER = 32;
// Voxels lit as parts of smooth surfaces, see voxelNormal()
const uint FLAG_SMOOTH = 64;
// Leaves and flowers swaying in the wind, see voxelHit()
const uint FLAG_WIND = 128;

// Has to match the material ids in src\worldgen.rs
const uint MAT_GRASS = 1;
const uint MAT_SAND = 4;
const uint MAT_WATER = 6;
const uint MAT_FOAM = 21;

// Bounce light only looks this far (in meters) for what it bounces off, which keeps it cheap
const float BOUNCE_DISTANCE = 12.0;
// And metal mirrors only what's this near
const float REFLECTION_DISTANCE = 30.0;
// Water only reflects what's this close, in meters, and the sky beyond
const float REFLECTION_REACH = 80.0;

// How much sunlight thin leaves let through
const float TRANSLUCENCY = 0.8;

// Haze: how far along each ray it's gathered (in meters), at how many points, and how quickly
// it thins out going up (meters for it to get e times thinner)
const float HAZE_REACH = 160.0;
const int HAZE_SAMPLES = 8;
const float HAZE_HEIGHT = 14.0;

// Has to match SUN_MAP_SIZE in main.rs
const int SUN_MAP_SIZE = 512;

// Triangle grass, see traceGrass(). Sizes in meters.
const float GRASS_CELL = 0.25;
const int GRASS_PER_CELL = 16;
const float GRASS_HEIGHT = 0.55;
const float GRASS_RANGE = 40.0;

// Meters from the water surface down to the sand outside the world, has to match src\worldgen.rs
const float SEABED_DEPTH = 6.0;

// Has to match src\worldgen.rs
const uint BRICK_WORDS = 16 + 128;
const uint SOLID_BRICK = 0x80000000u;
const uint EMPTY_BRICK = 0x40000000u;
// Stored bricks with leaves or flowers in them, which sway in the wind, see voxelHit()
const uint FOLIAGE_BRICK = 0x20000000u;
const uint BRICK_INDEX = FOLIAGE_BRICK - 1u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    mat4 pixelToRay;
    // Projects a world position into last frame's image: pixel = xy / z, with z the depth stored for it
    mat4 previousWorldToPixel;
    uvec4 world_size; // xyz: size in voxels, w: voxels per meter
    vec4 sun_direction; // xyz: normalized direction towards the sun, w: sea level in voxels (0 for no sea)
    uint render_mode;
    uint flags;
    uint frame;
    uint history_limit; // Most frames a pixel keeps averaging, 0 to ignore last frame entirely
    // Finer voxels in a box around the camera, see trace(). xyz: the box's corner in voxels of the
    // main world, w: how many fine voxels fit along a main one, 0 for no box
    vec4 near_origin;
    uvec4 near_size; // xyz: size of the box in fine voxels, w: how many animals there are
    // x: density of the haze per meter at sea level, y: seconds since the start, for things that
    // move, z: how many lights there are, w: how far away things fade into the sky, in voxels,
    // as only so much of the endless landscape is there at once (0 for no fading)
    vec4 haze;
    // xy: where the world's corner is in the whole landscape, in its voxels
    ivec4 window;
} pc;

// Levels of detail: the main world, and the box of finer voxels around the camera.
// Animals aren't a level of the world, but hits on them are told apart the same way.
const uint MAIN = 0;
const uint NEAR = 1;
const uint ANIMAL = 2;

// Each frame averages its new samples into what the same surfaces looked like last frame.
// The history images hold last frame's result, the others this frame's.
// Color images are linear (post.comp tone maps them) and keep the number of frames averaged in alpha.
// The target image is only written by the debug views, post.comp fills it in for the shaded one.
layout(set = 0, binding = 0, rgba8) writeonly uniform image2D targetImage;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D historyColor;
layout(set = 0, binding = 2, r32f) readonly uniform image2D historyDepth;
// The light each pixel sees averaged over frames, its color divided by guideImage's, with alpha how
// many frames
layout(set = 0, binding = 3, rgba32f) writeonly uniform image2D accumColor;
layout(set = 0, binding = 4, r32f) writeonly uniform image2D accumDepth;
// For post.comp and upscale.comp: what accumColor is divided by, the albedo of what each pixel
// sees as far as it shows through the haze, and in alpha which way the face points (0-5), 6 for
// the sky, 7 for water and grass, and 8 more than the face for what's held
layout(set = 0, binding = 5, rgba32f) writeonly uniform image2D guideImage;
// Distance from a plane facing the sun to the first thing sunlight hits, see sunMapBasis()
layout(set = 0, binding = 6, r32f) uniform image2D sunMap;
// One cell per 8x8x8 brick. EMPTY_BRICK | distance is empty, with the distance
// (in bricks, along any axis) to the nearest brick that isn't. SOLID_BRICK | material
// is filled with one material, anything else is 1 + the index of a stored brick.
layout(set = 1, binding = 0, r32ui) readonly uniform uimage3D brickGrid;
// BRICK_WORDS per stored brick: 16 words of occupancy bits, then one byte of
// material per voxel. Voxels are indexed by x + y * 8 + z * 64 within a brick.
layout(set = 1, binding = 1) readonly buffer Bricks {
    uint bricks[];
};
// Where grass grows, one texel per column of the main world: the ground's height in quarter
// voxels in bits 0-15, and how dense the grass is in bits 16-23, 0 for none
layout(set = 1, binding = 2, r32ui) readonly uniform uimage2D grassMap;
// The same for the finer voxels around the camera
layout(set = 2, binding = 0, r32ui) readonly uniform uimage3D nearGrid;
layout(set = 2, binding = 1) readonly buffer NearBricks {
    uint nearBricks[];
};

// Animals, see src\animals.rs. Each model is a box of voxels: two header words per model (where
// its voxels start, and its size packed x | y << 10 | z << 20), then the voxels' material ids, four
// to a word, indexed by x + (y + z * size.y) * size.x. Models face +x and stand on z = 0.
layout(set = 3, binding = 0) readonly buffer AnimalModels {
    uint animalModels[];
};
struct Animal {
    // xyz: where the middle of the bottom of its model is, in voxels of the main world, w: radius
    // of a sphere around it centered there
    vec4 position;
    vec4 rotation; // A quaternion turning its model the way it faces in the world
    vec4 scale; // x: size of its voxels in voxels of the main world
    uvec4 info; // x: model, y: STILL, MOVING or HELD, z: TINT_* for what weapons did to it
};
const uint STILL = 0;
const uint MOVING = 1;
// In the player's hand, moving with the camera. It's drawn in front of whatever it's poking into.
const uint HELD = 2;
const uint TINT_NONE = 0;
const uint TINT_BURNING = 1;
const uint TINT_FROZEN = 2;
const uint TINT_POISONED = 3;
const uint TINT_SHOCKED = 4;
const uint TINT_CHILLED = 5;
layout(set = 3, binding = 1) readonly buffer Animals {
    Animal animals[];
};

// Water isn't in the voxels: shaders\water.comp simulates it flowing over the ground, one column
// of the main world at a time. Per column, the top of the ground, and x the top of the water
// (below the ground for none) and y how churned up and white it is. Then the highest water in
// each block of WATER_BLOCK x WATER_BLOCK columns, -1 for none, so rays can skip dry land.
layout(set = 3, binding = 2, r32f) readonly uniform image2D waterGround;
layout(set = 3, binding = 3, rgba32f) readonly uniform image2D waterSurface;
layout(set = 3, binding = 4, r32f) readonly uniform image2D waterBlocks;
// Has to match BLOCK in shaders\water.comp
const int WATER_BLOCK = 8;

// Flames and glowing crystals near the camera, which light up what's around them. There are
// haze.z of them.
struct Light {
    vec4 position; // xyz: in voxels of the main world, w: how far its light reaches, in voxels
    vec4 color;
};
layout(set = 3, binding = 5) readonly buffer Lights {
    Light lights[];
};

// Light bounced onto each face of each voxel, gathered over many frames and kept, so it's only
// worked out once and stays steady. A hash table, CACHE_WORDS per entry: a key for the face (0 for
// none), the red, green and blue light summed over samples in fixed point, how many samples, and
// the frame it was last used in. Faces are keyed by where they are in the whole landscape, so it
// stays right when the world moves on to another piece of it.
layout(set = 3, binding = 6) buffer LightCache {
    uint cache[];
};
const uint CACHE_WORDS = 8;
const uint CACHE_PROBES = 8;
const float CACHE_SCALE = 1024.0;
// Once a face has this many samples it only takes the odd one more, so it can follow changes
const uint CACHE_SAMPLES = 48;
const uint NO_ENTRY = 0xFFFFFFFFu;

